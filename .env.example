# ==============================================================
# FECOCLIMA IA BACKEND - VARIABLES DE ENTORNO DE EJEMPLO
# Copie este archivo como .env y cambie TODOS los valores marcados.
# Nunca suba .env al repositorio ni distribuya credenciales reales.
# ==============================================================

# Aplicación
ENVIRONMENT=development
APP_NAME=FECOCLIMA IA API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
METRICS_ENABLED=true

# Puertos y exposición de Docker Compose
# En producción se recomienda mantener PostgreSQL y pgAdmin en 127.0.0.1.
API_BIND_IP=0.0.0.0
API_HOST_PORT=8000
API_PORT=8000
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=*
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_HOST_PORT=5437
PGADMIN_BIND_IP=127.0.0.1
PGADMIN_HOST_PORT=5050

# PostgreSQL + pgvector
POSTGRES_DB=fecoclimaia
POSTGRES_USER=fecoclima
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_DB_LARGA_Y_UNICA
DATABASE_URL=postgresql+asyncpg://fecoclima:CAMBIAR_PASSWORD_DB_LARGA_Y_UNICA@postgres:5432/fecoclimaia

# Seguridad y sesiones
# Genere JWT_SECRET, por ejemplo: openssl rand -hex 64
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://localhost:3017
TRUSTED_HOSTS=localhost,127.0.0.1
# Cadena aleatoria independiente, mínimo 32 caracteres. Ejemplo: openssl rand -base64 48
ENCRYPTION_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_INDEPENDIENTE_DE_32_CARACTERES

# Superusuario inicial
# Se crea únicamente cuando la tabla de usuarios está vacía.
SUPERADMIN_EMAIL=admin@fecoclima.com.py
SUPERADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN_FUERTE_12345
SUPERADMIN_NAME=Administrador FECOCLIMA

# Integración API FECOCLIMA
# La llave real clima-key NO está incluida en este proyecto.
FECOCLIMA_BASE_URL=https://fecoclima.fecoprod.com.py/clima/api
FECOCLIMA_API_KEY=
FECOCLIMA_TIMEOUT_SECONDS=30
FECOCLIMA_RETRY_COUNT=3

# El botón público "Analizar con IA" puede actualizar una ventana reciente de
# FECOCLIMA antes de calcular las reglas. Si el proveedor falla, se conservan
# y muestran los datos cacheados de PostgreSQL.
PUBLIC_ANALYSIS_SYNC_ENABLED=true
PUBLIC_ANALYSIS_SYNC_COOLDOWN_MINUTES=10
PUBLIC_ANALYSIS_SYNC_LOOKBACK_DAYS=3

# Pronóstico meteorológico
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Predicción diaria de todas las estaciones (un solo scheduler por entorno).
PREDICTION_DAILY_HOUR=6
PREDICTION_DAILY_MINUTE=0
PREDICTION_TIMEZONE=America/Asuncion
EXTERNAL_HTTP_TIMEOUT_SECONDS=45

# Catálogo satelital Copernicus/STAC (opcional)
# Debe apuntar a un endpoint STAC /search compatible.
COPERNICUS_STAC_SEARCH_URL=https://stac.dataspace.copernicus.eu/v1/search

# Proveedor de inteligencia artificial compatible con API tipo OpenAI (opcional)
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_PATH=/chat/completions
AI_EMBEDDINGS_PATH=/embeddings
AI_DEFAULT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536

# API compatible con Chat Completions del servidor Edge (por ejemplo Ollama/vLLM).
# Seleccione OPENAI o EDGE por agente en el CMS. No existe fallback de Edge a OpenAI.
EDGE_AI_BASE_URL=
EDGE_AI_API_KEY=
EDGE_AI_DEFAULT_MODEL=gemma3
EDGE_AI_SUPPORTS_IMAGES=false

# Correo para recuperación de contraseña y avisos diarios a productores
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
# El token y chat_id de Telegram se administran en /admin/notificaciones; el token se guarda cifrado.
# URL pública completa del frontend, incluido el prefijo de la aplicación.
# Desarrollo: http://localhost:3037/fecoclima-ia
# Producción: https://su-dominio.com/fecoclima-ia
FRONTEND_BASE_URL=http://localhost:3037/fecoclima-ia

# Archivos persistentes
STORAGE_PATH=/data
MAX_UPLOAD_MB=15
REPORT_RETENTION_DAYS=365

# Datos iniciales y procesos en segundo plano
LOAD_DEMO_DATA=false
SCHEDULER_SYNC_MINUTES=30
SCHEDULER_BACKUP_ENABLED=false
SCHEDULER_BACKUP_HOUR_UTC=2
WORKER_POLL_SECONDS=4
JOB_LOCK_TIMEOUT_MINUTES=30

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@fecoclima.com.py
PGADMIN_DEFAULT_PASSWORD=CAMBIAR_PASSWORD_PGADMIN
# Copernicus Data Space / Sentinel Hub (imagen RGB e índices; opcional)
# Crear un OAuth client en Copernicus Data Space y colocar ambos valores solo en .env.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
COPERNICUS_STATISTICS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
SATELLITE_LOOKBACK_DAYS=60
SATELLITE_MAX_CLOUD_PERCENTAGE=40
SATELLITE_AUTO_RADIUS_M=750
SATELLITE_REFRESH_HOURS=24

# Optional station-location services. Defaults work without an API key.
# Use a private Nominatim instance for deployments distributed across hosts.
STATION_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
STATION_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# Must match NUXT_PUBLIC_CSRF_COOKIE_NAME in the frontend.
CSRF_COOKIE_NAME=csrf_token
